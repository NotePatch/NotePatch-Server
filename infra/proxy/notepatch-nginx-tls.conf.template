map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 0.0.0.0:80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 302 https://__PUBLIC_IP____PUBLIC_PATH_PREFIX__/;
    }
}

server {
    listen 0.0.0.0:443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/__PUBLIC_IP__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_IP__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:NotePatchTLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 210m;

    location ~ ^__PUBLIC_PATH_PREFIX__/api/v1/.*/events/stream$ {
        rewrite ^__PUBLIC_PATH_PREFIX__(/api/v1/.*)$ $1 break;
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Prefix __PUBLIC_PATH_PREFIX__;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no always;
    }

    location __PUBLIC_PATH_PREFIX__/api/v1/ {
        rewrite ^__PUBLIC_PATH_PREFIX__(/api/v1/.*)$ $1 break;
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Prefix __PUBLIC_PATH_PREFIX__;
        proxy_read_timeout 300s;
    }

    location = __PUBLIC_PATH_PREFIX__/health {
        rewrite ^__PUBLIC_PATH_PREFIX__/health$ /health break;
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location __PUBLIC_PATH_PREFIX__/files/ {
        rewrite ^__PUBLIC_PATH_PREFIX__(/files/.*)$ $1 break;
        proxy_pass http://127.0.0.1:1080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Prefix __PUBLIC_PATH_PREFIX__;
        # tusd builds an absolute Location from its internal /files base path.
        # Restore the public random prefix so HEAD/PATCH use the same endpoint.
        proxy_redirect ~^https?://[^/]+/files/(.*)$ https://__PUBLIC_IP____PUBLIC_PATH_PREFIX__/files/$1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Keep the original URI and public Host: both participate in S3 SigV4.
    location /notepatch/ {
        proxy_pass http://127.0.0.1:8333;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location = __PUBLIC_PATH_PREFIX__ {
        return 308 __PUBLIC_PATH_PREFIX__/;
    }

    location __PUBLIC_PATH_PREFIX__/ {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location / {
        return 404;
    }
}
